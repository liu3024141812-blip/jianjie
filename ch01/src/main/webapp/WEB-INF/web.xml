<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>ch01</display-name>

    <!-- ============================================================
         MySQL / JDBC 配置：四个要素全部写在这里
         url 里的 & 必须写成 &amp;（XML 转义），否则 web.xml 解析失败
         ============================================================ -->

    <!-- 1. 驱动类名 -->
    <context-param>
        <param-name>jdbcDriver</param-name>
        <param-value>com.mysql.cj.jdbc.Driver</param-value>
    </context-param>

    <!-- 2. 连接地址：jdbc:mysql://主机:端口/数据库名?参数 -->
    <context-param>
        <param-name>jdbcUrl</param-name>
        <param-value>jdbc:mysql://localhost:3306/web?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Shanghai&amp;useUnicode=true&amp;characterEncoding=utf8</param-value>
    </context-param>

    <!-- 3. 用户名 -->
    <context-param>
        <param-name>jdbcUsername</param-name>
        <param-value>root</param-value>
    </context-param>

    <!-- 4. 密码 -->
    <context-param>
        <param-name>jdbcPassword</param-name>
        <param-value>302414</param-value>
    </context-param>

    <!-- 应用启动时读取上面四个参数并加载驱动 -->
    <listener>
        <listener-class>com.example.ch01.util.DbInitListener</listener-class>
    </listener>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
